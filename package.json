{
  "name": "strapi-plugin-video-chat",
  "version": "1.0.0",
  "description": "Audio/Video chat plugin for Strapi V5 using VDO.Ninja WebRTC technology",
  "keywords": [
    "strapi",
    "plugin",
    "video-chat",
    "audio-chat",
    "webrtc",
    "vdo-ninja",
    "video-call",
    "strapi-plugin"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/strapi-plugin-video-chat"
  },
  "strapi": {
    "name": "video-chat",
    "displayName": "Video Chat",
